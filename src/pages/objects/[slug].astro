---
import Base from '../../layouts/Base.astro';
import listings from '../../data/listings.json';
export function getStaticPaths(){return listings.map(l=>({params:{slug:l.slug},props:{l}}));}
const { l } = Astro.props;
---
<Base title={l.title}>
<div class="wrap detail">
  <div>
    <div class="ph" style={`background:linear-gradient(135deg,hsl(${l.hue} 60% 70%),hsl(${l.hue+30} 55% 45%))`}></div>
    <h1>{l.title}</h1>
    <div class="price">{l.price.toLocaleString('ru-RU')} €</div>
    <p class="meta">{l.city}, {l.district} · {l.type} · {l.area} м² · {l.rooms} комн.</p>
    <p>{l.desc}</p>
    <p><a href="/">← Все объекты</a></p>
  </div>
  <form id="contact" action="/api/lead" method="post">
    <b>Оставить заявку на показ</b>
    <input name="name" placeholder="Имя" required>
    <input name="phone" placeholder="Телефон" required>
    <textarea name="msg" rows="3" placeholder="Сообщение"></textarea>
    <input type="hidden" name="object" value={l.slug}>
    <button>Отправить</button>
  </form>
</div>
</Base>
