---
const { title = 'Демо — агентство недвижимости' } = Astro.props;
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<style is:global>
:root{--ink:#17212b;--muted:#5b6773;--line:#e3e8ee;--accent:#1f6feb;--bg:#f7f9fb}
*{box-sizing:border-box}body{margin:0;font:16px/1.5 system-ui,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit;text-decoration:none}
header{background:#fff;border-bottom:1px solid var(--line)}
.wrap{max-width:1080px;margin:0 auto;padding:0 16px}
nav{display:flex;justify-content:space-between;align-items:center;height:64px}
nav b{font-size:20px}nav a.btn{background:var(--accent);color:#fff;padding:8px 16px;border-radius:8px}
.hero{padding:56px 0 32px}.hero h1{font-size:clamp(28px,5vw,44px);margin:0 0 8px}.hero p{color:var(--muted);margin:0}
.filters{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}
select{padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:#fff;font:inherit}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px;padding-bottom:56px}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.ph{height:150px}.card div.b{padding:14px}.card h3{margin:0 0 4px;font-size:17px}
.price{font-weight:700;font-size:18px}.meta{color:var(--muted);font-size:14px}
.detail{display:grid;grid-template-columns:1fr 320px;gap:32px;padding:32px 16px 56px}
@media(max-width:760px){.detail{grid-template-columns:1fr}}
.detail .ph{height:320px;border-radius:12px}
form{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px;display:grid;gap:10px;align-self:start}
input,textarea{padding:10px 12px;border:1px solid var(--line);border-radius:8px;font:inherit;width:100%}
button{background:var(--accent);color:#fff;border:0;padding:12px;border-radius:8px;font:inherit;cursor:pointer}
footer{padding:24px 0;color:var(--muted);font-size:14px;border-top:1px solid var(--line);background:#fff}
</style>
</head>
<body>
<header><div class="wrap"><nav><a href="/"><b>Estate Demo</b></a><a class="btn" href="#contact">Связаться</a></nav></div></header>
<slot/>
<footer><div class="wrap">Демо-сайт. Данные вымышленные. Объекты в реальном проекте приходят из CMS.</div></footer>
</body></html>
